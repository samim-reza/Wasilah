# ---------------------------------------------------------------------------
# Wasilah — environment template
#
# Copy to `.env.local` and fill in. Never commit a filled-in file.
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are therefore PUBLIC.
# Everything else is server-only and must be set as a Supabase Edge Function
# secret (`supabase secrets set KEY=value`) or an EAS build secret.
# ---------------------------------------------------------------------------

# --- Supabase (client-safe) -------------------------------------------------
# The anon key is designed to be public; Row Level Security is what protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Observability (client-safe) -------------------------------------------
# Leave blank to disable. The app runs fine without either.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- App environment --------------------------------------------------------
# development | preview | production — controls logging verbosity and which
# Quran Foundation environment the edge proxy targets.
EXPO_PUBLIC_APP_ENV=development

# ===========================================================================
# SERVER-ONLY SECRETS — never prefix these with EXPO_PUBLIC_
# ===========================================================================

# --- Quran Foundation Content API ------------------------------------------
# Obtain from https://api-docs.quran.foundation (Developer Console).
# The client secret must only ever live in the Supabase Edge Function runtime.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# prelive | production. NOTE: prelive only serves Surah 1 and 2.
QF_ENV=prelive

# --- Weather (optional feature) ---------------------------------------------
# Open-Meteo needs no key; set this only if you switch to a keyed provider.
WEATHER_API_KEY=

# --- Supabase server-side ---------------------------------------------------
# Used by edge functions only. NEVER ship to a client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Push delivery ----------------------------------------------------------
# Expo access token used by the notification engine to send push messages.
EXPO_ACCESS_TOKEN=

# --- Build tooling (CI only) ------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
EAS_PROJECT_ID=
