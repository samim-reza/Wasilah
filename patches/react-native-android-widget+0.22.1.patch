+    /**
+     * Bitmaps up to this size travel inside the RemoteViews itself. Pixel data
+     * is parcelled through shared memory, so the binder transaction limit does
+     * not apply to it, and the AppWidgetService's own per-app bitmap budget is
+     * several times the screen. Only a very large widget on a very dense
+     * screen exceeds this, and it falls back to the content URI.
+     */
+    private static final int MAX_INLINE_BITMAP_BYTES = 8 * 1024 * 1024;
+
+    /**
+     * Hands the drawn bitmap to the launcher.
+     *
+     * Inline where it fits: a bitmap inside the RemoteViews is displayed by
+     * every launcher, with no permission or provider between the two apps.
+     * The content-URI path is kept for oversized bitmaps, and the launcher is
+     * granted read access to it explicitly rather than relying on the
+     * provider being exported.
+     */
+    private void setWidgetImage(RemoteViews remoteWidgetView, int viewId, int widgetId, String mode, Bitmap bitmap) {
+        if (bitmap.getByteCount() <= MAX_INLINE_BITMAP_BYTES) {
+            remoteWidgetView.setImageViewBitmap(viewId, bitmap);
+            return;
+        }
+
+        Uri bitmapUri = saveBitmapToDisk(widgetId, mode, bitmap);
+        grantReadToLaunchers(bitmapUri);
+        remoteWidgetView.setImageViewUri(viewId, bitmapUri);
+    }
+
+    private void grantReadToLaunchers(Uri uri) {
+        try {
+            Intent home = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME);
+            List<ResolveInfo> launchers = appContext.getPackageManager().queryIntentActivities(home, PackageManager.MATCH_DEFAULT_ONLY);
+            for (ResolveInfo launcher : launchers) {
+                appContext.grantUriPermission(launcher.activityInfo.packageName, uri, Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            }
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+    }
